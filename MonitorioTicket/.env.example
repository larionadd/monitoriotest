APP_NAME=TicketPing
APP_HOST=127.0.0.1
APP_PORT=8017
DATABASE_PATH=ticketping.sqlite3

# Put the regenerated BotFather token here. Do not commit real secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
MINI_APP_URL=

# Start bot polling inside the web process only for local experiments.
# Recommended: keep false and run .\run_bot.ps1 separately.
RUN_TELEGRAM_BOT=false

# Future API tokens
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
SKYSCANNER_API_KEY=

# Second flight source for live/flexible low-cost routes.
KIWI_TEQUILA_API_KEY=

# Ukrzaliznytsia ticket availability monitor.
# UZ does not provide stable public partner API here; this adapter uses app endpoints when available.
UZ_BOOKING_BASE=https://app.uz.gov.ua
RUN_RAIL_MONITOR=false
RAIL_MONITOR_INTERVAL_SECONDS=600
